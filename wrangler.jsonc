{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a11adgen",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No public per-version URLs. Set on purpose: when this field is missing, Wrangler sends no value and Cloudflare's default (on) can apply. The app is served from the main address only.
  "preview_urls": false,
  // The live Worker holds two plain values set outside this file: MCP_TOKEN_SHA256 and SIGNUP_CODE_SHA256 (hashes only).
  // Without keep_vars, every deploy from this file would delete them, and /mcp would reject every token.
  "keep_vars": true,
  // A deploy stops, and changes nothing, if one of these secrets is missing on the Worker.
  "secrets": { "required": ["FAL_KEY", "EXA_API_KEY"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a11adgen-db",
      "database_id": "79da5273-d683-4135-89f4-a1296ff4f34e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "e29131310aa446489fa715d74e1c35ff" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "a11adgen-assets" }],
  "images": { "binding": "IMAGES" },
  "vars": {
    "SPEND_CAP_USD": "10.56",
    "PUBLIC_BASE_URL": "https://a11adgen.gamingcomputing.workers.dev"
  }
  // Secrets (dashboard → Variables and Secrets): FAL_KEY, EXA_API_KEY. MCP_TOKEN_SHA256 holds only a hash.
}
